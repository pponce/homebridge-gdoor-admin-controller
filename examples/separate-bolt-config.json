{
  "platform": "GDoorAndBoltCoordinator",
  "name": "Example coordinator",
  "managementPort": 27773,
  "controllers": [
    {
      "id": "example-garage",
      "name": "Example garage and bolt",
      "door": {
        "type": "tailwind",
        "baseUrl": "http://tailwind.example.invalid",
        "doorIndex": 0,
        "credentialRef": "example-tailwind-key"
      },
      "bolt": {
        "type": "deconz",
        "baseUrl": "http://gateway.example.invalid",
        "gatewayId": "0011223344556677",
        "credentialRef": "example-deconz-key",
        "relayMode": "separate",
        "lockRelay": {
          "resourceId": "3",
          "uniqueId": "example-lock-output",
          "resourceType": "On/Off output",
          "modelId": "EXAMPLE-RELAY",
          "manufacturer": "Example"
        },
        "unlockRelay": {
          "resourceId": "4",
          "uniqueId": "example-unlock-output",
          "resourceType": "On/Off output",
          "modelId": "EXAMPLE-RELAY",
          "manufacturer": "Example"
        },
        "momentary": true,
        "pulseSeconds": 0.2
      },
      "exposeBoltLock": true,
      "timing": {
        "openRetractSettleSeconds": null,
        "closeRetractSettleSeconds": null
      },
      "feedback": {
        "closing": "sensor",
        "opening": "timed",
        "bolt": "command",
        "openingSeconds": 20,
        "closingSeconds": 20,
        "closedStableSeconds": 2,
        "boltSettleSeconds": 5,
        "allowEstimatedBolting": false
      }
    }
  ]
}
