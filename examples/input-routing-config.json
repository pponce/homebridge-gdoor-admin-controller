{
  "platform": "GDoorAndBoltCoordinator",
  "name": "Example coordinator",
  "managementPort": 27773,
  "controllers": [
    {
      "id": "example-garage",
      "name": "Example garage and bolt",
      "door": {
        "type": "tailwind",
        "baseUrl": "http://tailwind.example.invalid",
        "doorIndex": 0,
        "credentialRef": "example-tailwind-key"
      },
      "bolt": {
        "type": "deconz",
        "baseUrl": "http://gateway.example.invalid",
        "gatewayId": "0011223344556677",
        "resourceId": "1",
        "uniqueId": "example-bolt-endpoint",
        "resourceType": "On/Off output",
        "modelId": "EXAMPLE-RELAY",
        "manufacturer": "Example",
        "credentialRef": "example-deconz-key",
        "lockedValue": true
      },
      "exposeBoltLock": true,
      "feedback": {
        "closing": "sensor",
        "opening": "timed",
        "bolt": "relay",
        "openingSeconds": 20,
        "closingSeconds": 20,
        "closedStableSeconds": 2,
        "boltSettleSeconds": 5,
        "allowEstimatedBolting": false
      },
      "motorPaths": [
        {
          "id": "wall-relay",
          "name": "Opener push-button relay",
          "type": "pulse-relay",
          "connection": {
            "type": "deconz",
            "baseUrl": "http://gateway.example.invalid",
            "gatewayId": "0011223344556677",
            "resourceId": "2",
            "uniqueId": "example-motor-relay-endpoint",
            "resourceType": "On/Off output",
            "modelId": "EXAMPLE-MOTOR-RELAY",
            "manufacturer": "Example",
            "credentialRef": "example-deconz-key",
            "activeValue": true
          },
          "openPulseSeconds": 1,
          "closePulseSeconds": 1,
          "interruption": "stop-opening-reverse-closing"
        }
      ],
      "inputs": [
        {
          "id": "indoor-button",
          "name": "Indoor button",
          "enabled": true,
          "source": {
            "type": "deconz",
            "kind": "button",
            "baseUrl": "http://gateway.example.invalid",
            "gatewayId": "0011223344556677",
            "resourceId": "4",
            "uniqueId": "example-button-endpoint",
            "resourceType": "ZHASwitch",
            "modelId": "EXAMPLE-BUTTON",
            "manufacturer": "Example",
            "credentialRef": "example-deconz-key"
          },
          "trigger": 1002,
          "action": "toggle",
          "motorPath": "wall-relay",
          "busyBehavior": "interrupt",
          "rearmSeconds": 1.5,
          "timing": {
            "openRetractSettleSeconds": 2,
            "closeRetractSettleSeconds": 2
          }
        },
        {
          "id": "physical-keypad",
          "name": "Physical keypad",
          "enabled": true,
          "source": {
            "type": "deconz",
            "kind": "keypad",
            "baseUrl": "http://gateway.example.invalid",
            "gatewayId": "0011223344556677",
            "resourceId": "8",
            "uniqueId": "example-keypad-endpoint",
            "resourceType": "ZHAAncillaryControl",
            "modelId": "EXAMPLE-KEYPAD",
            "manufacturer": "Example",
            "credentialRef": "example-deconz-key",
            "alarmId": 1
          },
          "trigger": "native-outcome",
          "action": "keypad",
          "motorPath": "wall-relay",
          "busyBehavior": "drop",
          "rearmSeconds": 1.5,
          "timing": {}
        },
        {
          "id": "other-button",
          "name": "Another brand of button",
          "enabled": true,
          "source": {
            "type": "homebridge",
            "kind": "button",
            "bridgeId": "EXAMPLE-BUTTON-BRIDGE",
            "serviceId": "example-button-service",
            "credentialRef": "example-hb-key"
          },
          "trigger": 0,
          "action": "toggle",
          "motorPath": "wall-relay",
          "busyBehavior": "drop",
          "rearmSeconds": 1.5,
          "timing": {}
        }
      ]
    }
  ]
}
