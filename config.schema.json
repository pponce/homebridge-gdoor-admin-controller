{
  "pluginAlias": "GDoorAndBoltCoordinator",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Coordinate a garage door and separate bolt. Use the guided settings to choose devices, assign controls and review feedback. New or changed garages stay disabled until explicitly checked and enabled. See docs/owner-test.md for installation.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Garage Door and Bolt Coordinator"
      },
      "managementPort": {
        "title": "Local management API port",
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535,
        "default": 27773
      },
      "controllers": {
        "title": "Garage and bolt assemblies",
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "door",
            "bolt",
            "feedback",
            "exposeBoltLock"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "exposeBoltLock": {
              "title": "Expose optional Lock accessory",
              "type": "boolean",
              "default": false
            },
            "door": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "title": "Door connection",
                  "type": "string",
                  "enum": [
                    "tailwind",
                    "homebridge",
                    "ratgdo-homekit"
                  ],
                  "default": "tailwind"
                },
                "baseUrl": {
                  "title": "Opener local URL",
                  "type": "string",
                  "description": "Origin only, for example http://192.0.2.10. No key or /json suffix."
                },
                "doorIndex": {
                  "title": "Tailwind door index",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2,
                  "default": 0
                },
                "macAddress": {
                  "title": "ratgdo MAC address",
                  "type": "string",
                  "description": "Experimental homekit-ratgdo firmware only; pin the macAddress from /status.json."
                },
                "credentialRef": {
                  "title": "Credential reference",
                  "type": "string",
                  "description": "Name of an entry in private credentials.json, not the key itself."
                },
                "bridgeId": {
                  "title": "Homebridge bridge identity (future adapter)",
                  "type": "string"
                },
                "serviceId": {
                  "title": "Homebridge service identity (future adapter)",
                  "type": "string"
                }
              },
              "description": "Tailwind, existing Homebridge garage services, or experimental untested homekit-ratgdo local HTTP API. ratgdo authentication uses a private JSON username/password credential reference."
            },
            "bolt": {
              "type": "object",
              "required": [
                "type",
                "credentialRef"
              ],
              "properties": {
                "type": {
                  "title": "Bolt connection",
                  "type": "string",
                  "enum": [
                    "deconz",
                    "homebridge"
                  ],
                  "default": "deconz"
                },
                "baseUrl": {
                  "title": "deCONZ local URL",
                  "type": "string"
                },
                "gatewayId": {
                  "title": "deCONZ bridge ID",
                  "type": "string",
                  "description": "Expected 16-hex-digit gateway identity."
                },
                "resourceId": {
                  "title": "deCONZ light resource number",
                  "type": "string"
                },
                "uniqueId": {
                  "title": "deCONZ endpoint unique ID",
                  "type": "string"
                },
                "resourceType": {
                  "title": "Expected deCONZ resource type",
                  "type": "string",
                  "enum": [
                    "On/Off light",
                    "On/Off output",
                    "On/Off switch"
                  ]
                },
                "modelId": {
                  "title": "Expected deCONZ model ID",
                  "type": "string"
                },
                "manufacturer": {
                  "title": "Expected deCONZ manufacturer",
                  "type": "string"
                },
                "credentialRef": {
                  "title": "Credential reference",
                  "type": "string"
                },
                "lockedValue": {
                  "title": "Relay ON means bolt extended",
                  "type": "boolean",
                  "default": true
                },
                "bridgeId": {
                  "title": "Homebridge bridge identity (future adapter)",
                  "type": "string"
                },
                "serviceId": {
                  "title": "Homebridge service identity (future adapter)",
                  "type": "string"
                },
                "serviceType": {
                  "title": "Homebridge service type (future adapter)",
                  "type": "string",
                  "enum": [
                    "lock",
                    "switch",
                    "light"
                  ]
                }
              },
              "description": "Expected identity fields are checked before any relay read is accepted. Use JSON configuration for Homebridge declarations."
            },
            "feedback": {
              "type": "object",
              "properties": {
                "closing": {
                  "title": "Does closed come from a door sensor?",
                  "type": "string",
                  "enum": [
                    "sensor",
                    "timed"
                  ],
                  "default": "sensor",
                  "description": "Tailwind has a closed sensor. A command-only Homebridge value needs an explicit timed policy."
                },
                "opening": {
                  "title": "Does open mean physically fully open?",
                  "type": "string",
                  "enum": [
                    "sensor",
                    "timed"
                  ],
                  "default": "timed",
                  "description": "For Tailwind choose timed: its open state only means not closed. Opening time starts after the closed sensor departs."
                },
                "bolt": {
                  "title": "What proves the bolt state?",
                  "type": "string",
                  "enum": [
                    "position",
                    "relay"
                  ],
                  "default": "relay",
                  "description": "Direct deCONZ reports relay state. It does not prove physical bolt position. Timer-only bolt feedback is unsupported."
                },
                "openingSeconds": {
                  "title": "Estimated full opening travel (seconds)",
                  "type": "number",
                  "minimum": 1,
                  "maximum": 300,
                  "default": 20
                },
                "closingSeconds": {
                  "title": "Estimated full closing travel (seconds)",
                  "type": "number",
                  "minimum": 1,
                  "maximum": 300,
                  "default": 20
                },
                "closedStableSeconds": {
                  "title": "Continuous closed confirmation (seconds)",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60,
                  "default": 2
                },
                "boltSettleSeconds": {
                  "title": "Bolt extension settling time (seconds)",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60,
                  "default": 2
                },
                "allowEstimatedBolting": {
                  "title": "Allow bolting after an estimated close",
                  "type": "boolean",
                  "default": false,
                  "description": "Explicit policy for command-only closing feedback; elapsed time cannot prove the door is closed."
                }
              },
              "required": [
                "closing",
                "opening",
                "bolt",
                "openingSeconds",
                "closingSeconds",
                "closedStableSeconds",
                "boltSettleSeconds",
                "allowEstimatedBolting"
              ]
            },
            "motorPaths": {
              "title": "Additional motor paths",
              "type": "array",
              "maxItems": 4,
              "description": "Named opener pulse-relay connections. The primary Tailwind/Homebridge opener remains the HomeKit and virtual-keypad route. These are development declarations; see examples/input-routing-config.json.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type",
                  "connection",
                  "openPulseSeconds",
                  "closePulseSeconds",
                  "interruption"
                ],
                "properties": {
                  "id": {
                    "title": "Path ID",
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,47}$"
                  },
                  "name": {
                    "title": "Path name",
                    "type": "string",
                    "maxLength": 64
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "pulse-relay"
                    ],
                    "default": "pulse-relay"
                  },
                  "connection": {
                    "type": "object",
                    "description": "Supported deCONZ or Homebridge relay mapping, separate from the bolt. See the synthetic JSON example; input/output discovery is still being implemented."
                  },
                  "openPulseSeconds": {
                    "title": "Opening pulse duration (seconds)",
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 2,
                    "default": 1
                  },
                  "closePulseSeconds": {
                    "title": "Closing pulse duration (seconds)",
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 2,
                    "default": 1
                  },
                  "interruption": {
                    "title": "Requested indoor-button interruption behavior",
                    "type": "string",
                    "enum": [
                      "disabled",
                      "stop-opening-reverse-closing"
                    ],
                    "default": "disabled",
                    "description": "Only for a verified compatible relay/opener."
                  },
                  "allowDuringOpenerLockout": {
                    "title": "Allow operation during opener lockout",
                    "type": "boolean",
                    "default": false,
                    "description": "Requires the initiating physical button/keypad permission too. Other safeguards remain active."
                  }
                }
              }
            },
            "inputs": {
              "title": "Physical input assignments",
              "type": "array",
              "maxItems": 32,
              "description": "Each button, switch edge or keypad can target a named motor path for this garage. Aqara is not required. Live input adapters are not connected in this development build.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "enabled",
                  "source",
                  "trigger",
                  "action",
                  "motorPath",
                  "busyBehavior",
                  "rearmSeconds"
                ],
                "properties": {
                  "id": {
                    "title": "Input ID",
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,47}$"
                  },
                  "allowDuringOpenerLockout": {
                    "title": "Allow operation during opener lockout",
                    "type": "boolean",
                    "default": false,
                    "description": "Requires the selected relay device permission too. Primary opener routes and generic switches cannot bypass lockout."
                  },
                  "name": {
                    "title": "Input name",
                    "type": "string",
                    "maxLength": 64
                  },
                  "enabled": {
                    "title": "Request input enabled after commissioning",
                    "type": "boolean",
                    "default": false
                  },
                  "source": {
                    "type": "object",
                    "description": "deCONZ button/keypad or Homebridge button/switch identity. Input listeners are pending; see the JSON example."
                  },
                  "trigger": {
                    "title": "Button event, switch edge, or native-outcome",
                    "description": "Integer button event; on/off/either for switches; native-outcome for enrolled deCONZ keypad. Use JSON configuration until the device selector is implemented."
                  },
                  "action": {
                    "title": "Action",
                    "type": "string",
                    "enum": [
                      "open",
                      "close",
                      "toggle",
                      "keypad"
                    ]
                  },
                  "motorPath": {
                    "title": "Motor path ID",
                    "type": "string",
                    "description": "primary or one of this garage\u2019s additional motor-path IDs."
                  },
                  "busyBehavior": {
                    "title": "While another operation is in progress",
                    "type": "string",
                    "enum": [
                      "drop",
                      "interrupt"
                    ],
                    "default": "drop",
                    "description": "No queued commands. Interrupt requires a compatible configured relay path and the supported indoor-button runtime."
                  },
                  "rearmSeconds": {
                    "title": "Quiet time before accepting new events (seconds)",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10,
                    "default": 1.5
                  },
                  "timing": {
                    "type": "object",
                    "description": "Optional per-input openRetractSettleSeconds, closeRetractSettleSeconds, openingSeconds and closingSeconds."
                  }
                }
              }
            },
            "exposeTailwindLockout": {
              "title": "Show Tailwind Lockout contact sensor",
              "type": "boolean",
              "default": false
            },
            "exposeTailwindRestart": {
              "title": "Show Restart Tailwind switch",
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "connections": {
        "title": "Shared device connections",
        "type": "array",
        "maxItems": 128,
        "description": "Managed in General. Reusable deCONZ gateways, Tailwind controllers and Homebridge accessory bridges. Only saved key names belong here.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "type",
            "baseUrl",
            "credentialRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "type": {
              "type": "string",
              "enum": [
                "deconz",
                "tailwind",
                "homebridge"
              ]
            },
            "baseUrl": {
              "type": "string"
            },
            "credentialRef": {
              "type": "string"
            },
            "doorCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      }
    }
  },
  "customUi": true
}
